# ---- Endpoint (any OpenAI-compatible API) ----------------------------------
# Standard OpenAI: set the key, leave OPENAI_BASE_URL empty.
OPENAI_API_KEY=sk-...
# OpenAI-compatible gateway (Azure-hosted proxy, LiteLLM, vLLM, corporate gateway...):
# set the URL; the key may be blank for keyless gateways.
#OPENAI_BASE_URL=

# ---- Models -----------------------------------------------------------------
# Chat model: writes the situating blurbs, reranks (llm mode), and answers.
#CHAT_MODEL=gpt-5.4-mini
# Embedding model (multilingual-strong recommended for non-English corpora).
#EMBED_MODEL=text-embedding-3-large
# Vision model for PDF parsing; falls back to CHAT_MODEL if unset.
#PARSE_MODEL=

# ---- Contextualizer ----------------------------------------------------------
# Documents at/under this many tokens are situated against the WHOLE document
# (Anthropic's recipe); larger ones switch to head+region excerpts. Keep it
# ~20k tokens under the chat model's usable input: 250000 fits the GPT-5 family,
# a 128k-context model needs ~100000. Too high = hard API errors mid-ingestion.
#CONTEXT_DOC_CAP=250000
#CONTEXT_PART_TOKENS=48000
# Parallel blurb calls per prompt-prefix group (1 = sequential; raise within
# your key's rate limits).
#CONTEXT_CONCURRENCY=4

# ---- Retrieval ----------------------------------------------------------------
# Rerank fused candidates: "llm" (one cheap chat call, default) | "endpoint" | "off".
#RETRIEVAL_RERANK=llm
# Dedicated hosted reranker (Cohere/Jina shape) for "endpoint" mode.
#RERANK_MODEL=
#RERANK_BASE_URL=
#RERANK_API_KEY=
# Where the vector store persists (default ./.contextual_rag).
#VECTOR_DIR=

# ---- PDF parsing ---------------------------------------------------------------
# "vision" (default, needs the [pdf] extra) or "docintel" (Azure Document
# Intelligence, needs the [docintel] extra + the two settings below).
#PARSER=vision
#DOCINTEL_ENDPOINT=
#DOCINTEL_KEY=

# ---- Generation ----------------------------------------------------------------
#CHAT_TEMPERATURE=0.2
